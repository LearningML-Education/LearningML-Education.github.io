# Create a LinkedIn app at https://www.linkedin.com/developers/apps and copy these values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# This must exactly match an Authorized redirect URL in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8787/linkedin/callback

# Requires the "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn" products in the LinkedIn developer portal. Add w_organization_social
# only after LinkedIn has granted it to your app, then log in again.
LINKEDIN_SCOPES=openid profile w_member_social

# LinkedIn requires a currently supported monthly API version (YYYYMM).
LINKEDIN_API_VERSION=202606

# Numeric ID from the LearningML LinkedIn page URL. Required only for `--as learningml`.
LINKEDIN_ORGANIZATION_ID=
