---
const {
  title = 'LearningML',
  description = 'LearningML',
  lang = 'es',
  alternateUrl
} = Astro.props;
const currentLangLabel = lang === 'en' ? 'EN' : 'ES';
const alternateLangLabel = lang === 'en' ? 'ES' : 'EN';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f3efe7;
        --ink: #1e1b16;
        --accent: #e85d3f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Futura", "Gill Sans", "Trebuchet MS", sans-serif;
        background: radial-gradient(1200px 600px at 20% -10%, #fff5e8 0%, #f3efe7 60%, #efe6d8 100%);
        color: var(--ink);
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    {alternateUrl && (
      <nav class="lang-switcher" aria-label="Language selector">
        <span class="lang-switcher__current" aria-current="true">{currentLangLabel}</span>
        <a class="lang-switcher__link" href={alternateUrl}>{alternateLangLabel}</a>
      </nav>
    )}
    <slot />
  </body>
</html>

<style>
  .lang-switcher {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 10;
  }

  .lang-switcher__current {
    color: var(--ink);
  }

  .lang-switcher__link {
    color: var(--accent);
  }
</style>
