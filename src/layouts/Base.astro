---
const { title = 'LearningML', description = 'LearningML' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f3efe7;
        --ink: #1e1b16;
        --accent: #e85d3f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Futura", "Gill Sans", "Trebuchet MS", sans-serif;
        background: radial-gradient(1200px 600px at 20% -10%, #fff5e8 0%, #f3efe7 60%, #efe6d8 100%);
        color: var(--ink);
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
