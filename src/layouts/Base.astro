---
const {
  title = 'LearningML',
  description = 'LearningML',
  lang = 'es',
  alternateUrl
} = Astro.props;
const currentLangLabel = lang === 'en' ? 'EN' : 'ES';
const alternateLangLabel = lang === 'en' ? 'ES' : 'EN';
const contactFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLScxfjvWbEmRRYu4pT2F1Q8zEY7lE42TI2hZWWL9pyf7CaHNYg/viewform?usp=publish-editor';
const footerLinks = lang === 'en'
  ? [
      { label: 'About LearningML', href: '/en/about-learningml/' },
      { label: 'About Scratch', href: '/en/about-scratch/' },
      { label: 'Terms of Use', href: '/en/legal-note/' }
    ]
  : [
      { label: 'Sobre LearningML', href: '/sobre-learningml/' },
      { label: 'Sobre Scratch', href: '/sobre-scratch/' },
      { label: 'Términos de uso', href: '/nota-legal/' },
      { label: 'Fundación Cruzando', href: '/fundacioncruzando/' }
    ];
const navLinks = lang === 'en'
  ? [
      { label: 'What is', href: '/en/what-is-machine-learning/' },
      { label: 'Why', href: '/en/why-learn-machine-learning/' },
      { label: 'Blog', href: '/en/blog/' },
      { label: 'Studies', href: '/en/studies-about-learningml/' },
      { label: 'Manual', href: 'https://learningml.org/lml-doc/' }
    ]
  : [
      { label: 'Qué es', href: '/que-es-ml/' },
      { label: 'Por qué', href: '/por-que-aprender-ml/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Estudios', href: '/trabajos-sobre-learningml/' },
      { label: 'Manual', href: 'https://learningml.org/lml-doc/' },
      { label: 'Fundación Cruzando', href: '/fundacioncruzando/' }
    ];
const aboutLinks = lang === 'en'
  ? [
      { label: 'About', href: '/en/about-learningml-and-its-author/' },
      { label: 'Acknowledgments', href: '/en/acknowledgment/' }
    ]
  : [
      { label: 'Acerca de', href: '/acerca-de-learningml-y-su-autor/' },
      { label: 'Agradecimientos', href: '/agradecimientos/' }
    ];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700&family=Nunito+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXGZS2VVP4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RXGZS2VVP4');
    </script>
    <style>
      :root {
        color-scheme: light;
        --bg: #E6F0EE;
        --surface: #F2F7F6;
        --surface-soft: #FBFCFC;
        --surface-strong: #ffffff;
        --ink: #192c27;
        --muted: #365951;
        --accent: #007f5f;
        --accent-2: #55a630;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Nunito Sans", "Trebuchet MS", "Gill Sans", sans-serif;
        background: radial-gradient(1200px 600px at 20% -10%, var(--surface-strong) 0%, var(--bg) 60%, var(--surface) 100%);
        color: var(--ink);
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    {alternateUrl && (
      <nav class="lang-switcher" aria-label="Language selector">
        <span class="lang-switcher__current" aria-current="true">{currentLangLabel}</span>
        <a class="lang-switcher__link" href={alternateUrl}>{alternateLangLabel}</a>
      </nav>
    )}
    <header class="site-nav">
      <a class="site-nav__brand" href={lang === 'en' ? '/en/' : '/'} aria-label="LearningML home">
        <img src="/genio-cabeza-logo.png" alt="" width="48" height="48" />
        <span>LearningML - AI Made easy</span>
      </a>
      <nav class="site-nav__links" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <details class="site-nav__dropdown">
          <summary>
            {lang === 'en' ? 'About' : 'Acerca de'}
            <span class="site-nav__caret" aria-hidden="true">▾</span>
          </summary>
          <div class="site-nav__submenu">
            {aboutLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </details>
        <form class="site-nav__donate-form" action="https://www.paypal.com/donate" method="post" target="_top">
          <input type="hidden" name="hosted_button_id" value="DRDC7RAA8X59U" />
          <input
            class="site-nav__donate-button"
            type="image"
            src="https://www.paypalobjects.com/es_ES/ES/i/btn/btn_donate_SM.gif"
            border="0"
            name="submit"
            title="PayPal - The safer, easier way to pay online!"
            alt={lang === 'en' ? 'Donate with PayPal button' : 'Botón Donar con PayPal'}
          />
          <img alt="" border="0" src="https://www.paypal.com/es_ES/i/scr/pixel.gif" width="1" height="1" />
        </form>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__social">
          <span class="site-footer__label">Redes Sociales</span>
          <div class="site-footer__icons">
            <a class="site-footer__icon" href="http://x.com/_learningml_" aria-label="X">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M18.9 2H22l-6.8 7.7L23 22h-6.2l-4.8-6.2L6.4 22H3.3l7.2-8.1L1 2h6.3l4.3 5.7L18.9 2zm-1.1 18h1.7L6.2 3.7H4.4L17.8 20z" />
              </svg>
            </a>
            <a class="site-footer__icon" href="https://www.instagram.com/learningml_asoc/" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 3.5A5.5 5.5 0 1 1 6.5 13 5.5 5.5 0 0 1 12 7.5zm0 2A3.5 3.5 0 1 0 15.5 13 3.5 3.5 0 0 0 12 9.5zm6.3-3.2a1.2 1.2 0 1 1-1.2-1.2 1.2 1.2 0 0 1 1.2 1.2z" />
              </svg>
            </a>
            <a class="site-footer__icon" href="https://www.linkedin.com/company/learningml/posts/?feedView=all" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6.9 9.4V21H3.7V9.4h3.2zM5.3 3C6.4 3 7.2 3.8 7.2 4.9S6.4 6.8 5.3 6.8 3.4 6 3.4 4.9 4.2 3 5.3 3zM20.7 14.1V21h-3.2v-6.1c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.3-.1.2-.1.6-.1 1V21h-3.2s.1-10.2 0-11.3h3.2v1.6c.4-.7 1.2-1.7 3-1.7 2.2 0 3.9 1.4 3.9 4.5z" />
              </svg>
            </a>
            <a class="site-footer__icon" href="https://www.youtube.com/@learningml_org" aria-label="YouTube">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M23 7.7s-.2-1.7-.9-2.4c-.8-.9-1.8-.9-2.3-1C16.3 4 12 4 12 4s-4.3 0-7.8.3c-.5.1-1.5.1-2.3 1C1.2 6 1 7.7 1 7.7S.7 9.6.7 11.5v1.9c0 1.9.3 3.8.3 3.8s.2 1.7.9 2.4c.8.9 1.9.9 2.4 1 1.7.2 7.7.3 7.7.3s4.3 0 7.8-.3c.5-.1 1.5-.1 2.3-1 .7-.7.9-2.4.9-2.4s.3-1.9.3-3.8v-1.9c0-1.9-.3-3.8-.3-3.8zM9.7 15.2V8.8l6 3.2-6 3.2z" />
              </svg>
            </a>
          </div>
          <a class="site-footer__contact-link" href={contactFormUrl} target="_blank" rel="noopener noreferrer">
            {lang === 'en' ? 'Contact form' : 'Formulario de contacto'}
          </a>
        </div>
        <div class="site-footer__links">
          {footerLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
        <div class="site-footer__legal">
          <p>LearningML Copyright © 2026 Juan David Rodríguez García</p>
          <p>
            LearningML web page by Juan David Rodríguez García is licensed under
            Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .lang-switcher {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 10;
  }

  .lang-switcher__current {
    color: var(--ink);
  }

  .lang-switcher__link {
    color: var(--accent);
  }

  .site-nav {
    max-width: 1100px;
    margin: 2rem auto 0;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .site-nav__brand img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    border-radius: 999px;
  }

  .site-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: "Nunito", "Trebuchet MS", "Gill Sans", sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    align-items: center;
  }

  .site-nav__donate-form {
    display: inline-flex;
    align-items: center;
  }

  .site-nav__donate-button {
    vertical-align: middle;
  }

  .site-nav__dropdown {
    position: relative;
  }

  .site-nav__dropdown summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-nav__dropdown summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__caret {
    font-size: 0.85rem;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .site-nav__dropdown[open] .site-nav__caret {
    transform: rotate(180deg);
  }

  .site-nav__submenu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    background: var(--surface-strong);
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    display: grid;
    gap: 0.4rem;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    min-width: 180px;
    z-index: 6;
  }

  .site-nav__dropdown:not([open]) .site-nav__submenu {
    display: none;
  }

  .site-nav__submenu a {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .site-nav {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .site-footer {
    padding: 2.5rem 1.5rem 3rem;
  }

  .site-footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 1.5rem;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
  }

  .site-footer__social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .site-footer__label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(25, 44, 39, 0.7);
  }

  .site-footer__icons {
    display: flex;
    gap: 0.75rem;
  }

  .site-footer__icon {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 127, 95, 0.12);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .site-footer__icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .site-footer__icon:hover {
    transform: translateY(-2px);
    background: rgba(0, 127, 95, 0.2);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .site-footer__contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    background: rgba(0, 127, 95, 0.12);
    color: var(--ink);
  }

  .site-footer__links a {
    font-weight: 600;
  }

  .site-footer__legal {
    font-size: 0.8rem;
    color: rgba(25, 44, 39, 0.6);
    flex-basis: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      align-items: flex-start;
    }
    .site-footer__links {
      gap: 0.75rem 1rem;
    }
  }
</style>
