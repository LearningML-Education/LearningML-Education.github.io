---
import Base from './Base.astro';

const { title, date, lang = 'es', alternateUrl } = Astro.props;
const formattedDate = date
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }).format(new Date(date))
  : '';
---
<Base title={title} description={title} lang={lang} alternateUrl={alternateUrl}>
  <main class="post">
    <header class="post__header">
      <a class="post__back" href={lang === 'en' ? '/en/' : '/'}>← {lang === 'en' ? 'Home' : 'Inicio'}</a>
      <p class="post__meta">{formattedDate}</p>
      <h1>{title}</h1>
    </header>
    <article class="post__content">
      <slot />
    </article>
  </main>

  <style>
    .post {
      max-width: 880px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    .post__header {
      max-width: 720px;
      margin: 0 auto 2.5rem;
      text-align: center;
    }
    .post__back {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      background: rgba(0, 127, 95, 0.1);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      text-decoration: none;
      transition: background 0.2s ease;
    }
    .post__back:hover {
      background: rgba(0, 127, 95, 0.18);
    }
    .post__meta {
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
      margin: 1.5rem 0 0.75rem;
    }
    .post__header h1 {
      margin: 0;
      font-family: "Nunito", "Trebuchet MS", "Gill Sans", sans-serif;
      font-size: clamp(1.9rem, 4vw, 2.75rem);
      line-height: 1.15;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }
    .post__header h1::after {
      content: "";
      display: block;
      width: 3.5rem;
      height: 4px;
      margin: 1.5rem auto 0;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
    }
    .post__content {
      background: var(--surface-strong);
      border-radius: 1.5rem;
      padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1.25rem, 6vw, 4.5rem);
      box-shadow: 0 1px 2px rgba(25, 44, 39, 0.04), 0 20px 48px rgba(25, 44, 39, 0.07);
      font-size: 1.0625rem;
      color: #24372f;
    }
    .post__content > :global(:first-child) {
      margin-top: 0;
    }
    .post__content > :global(:last-child) {
      margin-bottom: 0;
    }
    .post__content :global(p) {
      line-height: 1.8;
      margin: 1.1rem 0;
    }
    .post__content :global(h2),
    .post__content :global(h3),
    .post__content :global(h4) {
      font-family: "Nunito", "Trebuchet MS", "Gill Sans", sans-serif;
      color: var(--ink);
      line-height: 1.25;
      text-wrap: balance;
    }
    .post__content :global(h2) {
      font-size: 1.6rem;
      margin: 3.5rem 0 1rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(0, 127, 95, 0.15);
    }
    .post__content :global(h3) {
      font-size: 1.2rem;
      margin: 2.5rem 0 0.75rem;
      color: var(--accent);
    }
    .post__content :global(h4) {
      font-size: 1.05rem;
      margin: 2rem 0 0.5rem;
    }
    .post__content :global(a) {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: rgba(0, 127, 95, 0.35);
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
      transition: text-decoration-color 0.2s ease;
    }
    .post__content :global(a:hover) {
      text-decoration-color: currentColor;
    }
    .post__content :global(strong) {
      color: var(--ink);
    }
    .post__content :global(ul),
    .post__content :global(ol) {
      padding-left: 1.4rem;
      line-height: 1.75;
    }
    .post__content :global(li) {
      margin: 0.4rem 0;
    }
    .post__content :global(li::marker) {
      color: var(--accent);
    }
    .post__content :global(blockquote) {
      margin: 2rem 0;
      padding: 1rem 1.5rem;
      border-left: 4px solid var(--accent-2);
      border-radius: 0 0.75rem 0.75rem 0;
      background: var(--surface);
      color: var(--muted);
    }
    .post__content :global(blockquote p) {
      margin: 0.5rem 0;
    }
    .post__content :global(hr) {
      border: 0;
      height: 1px;
      margin: 3rem 0;
      background: rgba(0, 127, 95, 0.15);
    }
    .post__content :global(img) {
      max-width: 100%;
      height: auto;
    }
    .post__content :global(p > img:only-child) {
      display: block;
      margin: 2.25rem auto;
      border-radius: 1rem;
      border: 1px solid rgba(25, 44, 39, 0.08);
      box-shadow: 0 14px 32px rgba(25, 44, 39, 0.1);
    }
    .post__content :global(.work-grid) {
      margin-top: 2rem;
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .post__content :global(.work-card) {
      display: grid;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 1rem;
      background: var(--surface-soft);
      border: 1px solid rgba(25, 44, 39, 0.06);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      text-decoration: none;
      color: inherit;
    }
    .post__content :global(.work-card:hover) {
      transform: translateY(-4px);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.1);
    }
    .post__content :global(.work-card img) {
      width: 100%;
      height: auto;
      border-radius: 0.75rem;
      display: block;
    }
    .post__content :global(.work-card__title) {
      font-weight: 600;
      line-height: 1.4;
    }
    .post__content :global(.post__split) {
      display: grid;
      gap: 2rem;
      align-items: start;
      grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    }
    .post__content :global(.post__split-media img) {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 1rem;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    }
    .post__content :global(.post__split-content p) {
      margin-top: 0;
    }
    @media (max-width: 800px) {
      .post__content :global(.post__split) {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 600px) {
      .post {
        padding: 1.5rem 0.75rem 3rem;
      }
      .post__content {
        border-radius: 1rem;
        font-size: 1rem;
      }
    }
  </style>
</Base>
