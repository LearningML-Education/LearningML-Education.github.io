---
import Base from './Base.astro';

const { title, date, lang = 'es', alternateUrl } = Astro.props;
const formattedDate = date
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }).format(new Date(date))
  : '';
---
<Base title={title} description={title} lang={lang} alternateUrl={alternateUrl}>
  <main class="post">
    <header class="post__header">
      <a class="post__back" href={lang === 'en' ? '/en/' : '/'}>← {lang === 'en' ? 'Home' : 'Inicio'}</a>
      <p class="post__meta">{formattedDate}</p>
      <h1>{title}</h1>
    </header>
    <article class="post__content">
      <slot />
    </article>
  </main>

  <style>
    .post {
      max-width: 780px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }
    .post__meta {
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-size: 0.7rem;
      color: rgba(30, 27, 22, 0.7);
      margin: 0 0 0.5rem;
    }
    .post__header h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(2rem, 3vw, 3rem);
    }
    .post__back {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
      color: var(--accent);
    }
    .post__content :global(p) {
      line-height: 1.75;
      margin: 1rem 0;
    }
    .post__content :global(h2),
    .post__content :global(h3),
    .post__content :global(h4) {
      margin-top: 2rem;
    }
    .post__content :global(a) {
      text-decoration: underline;
    }
    .post__content :global(.work-grid) {
      margin-top: 2rem;
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .post__content :global(.work-card) {
      display: grid;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 1rem;
      background: #fff;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      text-decoration: none;
      color: inherit;
    }
    .post__content :global(.work-card:hover) {
      transform: translateY(-4px);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
    }
    .post__content :global(.work-card img) {
      width: 100%;
      height: auto;
      border-radius: 0.75rem;
      display: block;
    }
    .post__content :global(.work-card__title) {
      font-weight: 600;
      line-height: 1.4;
    }
    .post__content :global(.post__split) {
      display: grid;
      gap: 2rem;
      align-items: start;
      grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    }
    .post__content :global(.post__split-media img) {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 1rem;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    }
    .post__content :global(.post__split-content p) {
      margin-top: 0;
    }
    @media (max-width: 800px) {
      .post__content :global(.post__split) {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
