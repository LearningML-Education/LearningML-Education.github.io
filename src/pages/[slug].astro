---
import Post from '../layouts/Post.astro';
import { getCollection } from 'astro:content';
import { normalizePostSlug } from '../utils/postSlug';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const spanishPosts = posts.filter(post => post.slug.startsWith('es/'));
  return spanishPosts.map(post => ({
    params: { slug: normalizePostSlug(post.slug) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const slug = normalizePostSlug(post.slug);
const alternateSlug = post.data.translation;
---
<Post
  title={post.data.title}
  date={post.data.date}
  lang="es"
  alternateUrl={alternateSlug ? `/en/${alternateSlug}/` : undefined}
>
  <Content />
</Post>
