---
import Post from '../../layouts/Post.astro';
import { getCollection } from 'astro:content';
import { normalizePostSlug } from '../../utils/postSlug';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const englishPosts = posts.filter(post => post.slug.startsWith('en/'));
  return englishPosts.map(post => ({
    params: { slug: normalizePostSlug(post.slug) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Post title={post.data.title} date={post.data.date} lang="en">
  <Content />
</Post>
