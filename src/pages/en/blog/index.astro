---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { normalizePostSlug } from '../../../utils/postSlug';
import { marked } from 'marked';
import { truncateHtmlWords } from '../../../utils/truncateHtml';

const posts = await getCollection('posts');
const englishPosts = posts
  .filter(post => post.slug.startsWith('en/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const cards = await Promise.all(
  englishPosts.map(async (post) => {
    const formattedDate = post.data.date
      ? new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }).format(new Date(post.data.date))
      : '';
    return {
      title: post.data.title,
      href: `/en/${normalizePostSlug(post.slug)}/`,
      excerptHtml: truncateHtmlWords(marked.parse(post.body), 40),
      date: formattedDate
    };
  })
);
---
<Base
  title="LearningML Blog"
  description="LearningML articles in English"
  lang="en"
  alternateUrl="/blog/"
>
  <main class="list">
    <h1>Blog</h1>
    <section class="cards">
      {cards.map((card) => (
        <article class="card">
          <a class="card__overlay" href={card.href} aria-label={card.title}></a>
          <div class="card__content">
            {card.date ? <span class="card__date">{card.date}</span> : null}
            <h2>{card.title}</h2>
            <div class="card__excerpt" set:html={card.excerptHtml} />
            <span class="card__ellipsis">...</span>
          </div>
        </article>
      ))}
    </section>
  </main>

  <style>
    .list {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }
    .cards {
      margin: 2rem 0 0;
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
    .card {
      display: grid;
      gap: 0.75rem;
      padding: 1.5rem;
      background: #fff;
      border-radius: 1.25rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      position: relative;
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
    }
    .card__overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
    }
    .card__content {
      position: relative;
      z-index: 1;
      pointer-events: none;
    }
    .card__date {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.7rem;
      color: rgba(30, 27, 22, 0.6);
    }
    .card h2 {
      margin: 0;
      font-size: 1.2rem;
    }
    .card p {
      margin: 0;
      line-height: 1.6;
      opacity: 0.75;
    }
    .card__excerpt :global(p) {
      margin: 0;
      line-height: 1.6;
      opacity: 0.75;
    }
    .card__excerpt :global(a) {
      text-decoration: underline;
    }
    .card__ellipsis {
      opacity: 0.75;
    }
  </style>
</Base>
