---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const englishPosts = posts
  .filter(post => post.data.categories.includes('blog-en'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="LearningML Blog" description="LearningML articles in English">
  <main class="list">
    <h1>Blog</h1>
    <ul>
      {englishPosts.map(post => (
        <li>
          <a href={`/en/${post.slug}/`}>{post.data.title}</a>
          <span>{post.data.date.toISOString().slice(0, 10)}</span>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .list {
      max-width: 820px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }
    ul {
      list-style: none;
      padding: 0;
      margin: 2rem 0 0;
      display: grid;
      gap: 1rem;
    }
    li {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    }
    a {
      font-weight: 600;
    }
    span {
      opacity: 0.6;
      white-space: nowrap;
    }
  </style>
</Base>
