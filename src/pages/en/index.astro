---
import Base from '../../layouts/Base.astro';

const openEditorUrl = import.meta.env.PUBLIC_LML_OPEN_EDITOR_URL ?? '/lml-editor/';
const openScratchUrl = import.meta.env.PUBLIC_LML_OPEN_SCRATCH_URL ?? '/scratch/';
const desktopUrl = import.meta.env.PUBLIC_LML_DESKTOP_URL ?? '/en/learningml-desktop/';
---
<Base
  title="LearningML - AI Made easy"
  description="Learn AI by building real projects"
  lang="en"
  alternateUrl="/"
>
  <main class="hero">
    <section class="hero__content">
      <p class="hero__eyebrow">Creative Artificial Intelligence</p>
      <div class="hero__headline">
        <h1>Learn Machine Learning Fundamentals</h1>
        <div class="hero__side">
          <a
            class="hero__ribbon"
            href="https://all-digital.org/all-digital-awards-2024-best-digital-resource/"
          >
            <span class="hero__ribbon-icon" aria-hidden="true">🏆</span>
            All Digital Awards 2024 Winner
          </a>
        </div>
      </div>
      <p class="hero__lead">
        LearningML combines a visual editor with Scratch so anyone can train models
        and create interactive experiences.
      </p>
      <div class="hero__cta">
        <a class="button primary" href={openEditorUrl}>Open editor</a>
        <a class="button ghost" href={openScratchUrl}>Go to Scratch</a>
        <a class="button ghost" href={desktopUrl}>LearningML Desktop</a>
      </div>
    </section>

    <section class="hero__grid">
      <article>
        <h3>Collect Data</h3>
        <p>Collect texts or images about something you want to classify automatically and add them to LearningML, indicating which class each one belongs to. These data make up the training set.</p>
      </article>
      <article>
        <h3>Create a model</h3>
        <p>Build with LearningML a model capable of correctly classifying other data that are different, yet similar, to those in the training set.</p>
      </article>
      <article>
        <h3>Build an application</h3>
        <p>Export your Machine Learning model to Scratch and program an application capable of classifying data about the topic you chose. Congratulations! You have added Artificial Intelligence to your Scratch program!</p>
      </article>
    </section>

    <section class="hero__video">
      <h2>Mini tutorial: how to use LearningML</h2>
      <video controls autoplay muted loop preload="metadata" playsinline>
        <source src="https://web.learningml.org/wp-content/uploads/2020/05/mini-tutorial-intro-imagenes.mp4" type="video/mp4" />
        Your browser does not support video playback.
      </video>
    </section>

  </main>

  <style>
    .hero {
      min-height: auto;
      padding: 3rem clamp(1.5rem, 4vw, 5rem);
      margin-bottom: 2rem;
      display: grid;
      gap: 0.85rem;
      position: relative;
      isolation: isolate;
      color: var(--surface-strong);
      background-image:
        linear-gradient(rgba(25, 44, 39, 0.4), rgba(25, 44, 39, 0.4)),
        url('/genio-maquina-home.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }


    .hero__content h1 {
      font-size: clamp(2.4rem, 4vw, 4.2rem);
      margin: 0.4rem 0 0;
    }

    .hero__content {
      display: grid;
      gap: 0.85rem;
      align-content: start;
    }
    .hero__headline {
      display: grid;
      gap: 1rem;
      align-items: start;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    }

    .hero__side {
      display: grid;
      gap: 0.75rem;
      justify-items: start;
    }

    .hero__ribbon {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      border-radius: 999px;
      background: var(--accent);
      border: 1px solid var(--accent);
      color: var(--surface-strong);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
      white-space: nowrap;
    }
    .hero__ribbon-icon {
      font-size: 1rem;
    }

    .hero__eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.75rem;
      margin: 0;
    }

    .hero__lead {
      max-width: 60ch;
      font-size: 1.1rem;
      line-height: 1.7;
    }
    @media (max-width: 900px) {
      .hero__headline {
        grid-template-columns: 1fr;
        justify-items: start;
      }
      .hero__side {
        width: 100%;
      }
      .hero__ribbon {
        white-space: normal;
      }
    }

    .hero__cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 0.85rem;
      justify-content: center;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: var(--surface-strong);
      text-decoration: none;
    }

    .button.primary {
      background: var(--accent);
      color: var(--surface-strong);
    }

    .button.ghost {
      background: var(--accent);
      color: var(--surface-strong);
    }

    .hero__grid {
      display: grid;
      gap: 1.5rem;
      margin-top: 0.5rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      align-items: start;
    }

    .hero__grid article {
      height: 100%;
      padding: 0.5rem;
      border-radius: 1.25rem;
      background: rgba(255, 255, 255, 0.92);
      color: var(--ink);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .hero__video {
      background: rgba(255, 255, 255, 0.92);
      color: var(--ink);
      border-radius: 1.25rem;
      padding: 1.25rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      margin-top: 1rem;
    }

    .hero__video h2 {
      margin: 0 0 0.85rem;
      font-size: clamp(1.15rem, 2vw, 1.6rem);
    }

    .hero__video video {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 0.85rem;
      background: #000;
    }
  </style>
</Base>
