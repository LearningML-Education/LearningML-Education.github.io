---
import Base from '../../layouts/Base.astro';
---
<Base
  title="LearningML"
  description="Learn AI by building real projects"
  lang="en"
  alternateUrl="/"
>
  <main class="hero">
    <header class="hero__header">
      <div class="hero__mark">LearningML</div>
      <nav class="hero__nav">
        <a href="/lml-editor/">Editor</a>
        <a href="/scratch/">Scratch</a>
        <a href="https://learningml.org/manual/">Manual</a>
      </nav>
    </header>

    <section class="hero__content">
      <p class="hero__eyebrow">Creative Artificial Intelligence</p>
      <h1>Learn Machine Learning by building projects with your data.</h1>
      <p class="hero__lead">
        LearningML combines a visual editor with Scratch so anyone can train models
        and create interactive experiences.
      </p>
      <div class="hero__cta">
        <a class="button primary" href="/lml-editor/">Open editor</a>
        <a class="button ghost" href="/scratch/">Go to Scratch</a>
      </div>
    </section>

    <section class="hero__grid">
      <article>
        <h3>Visual</h3>
        <p>Step-by-step guided models, no coding required.</p>
      </article>
      <article>
        <h3>Real projects</h3>
        <p>Bring your models into games, music, and art with Scratch.</p>
      </article>
      <article>
        <h3>Community</h3>
        <p>Resources and activities designed for the classroom.</p>
      </article>
    </section>
  </main>

  <style>
    .hero {
      min-height: 100vh;
      padding: 3rem clamp(1.5rem, 4vw, 5rem);
      display: grid;
      gap: 3rem;
    }

    .hero__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }

    .hero__mark {
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .hero__nav {
      display: flex;
      gap: 1.5rem;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .hero__content h1 {
      font-size: clamp(2.4rem, 4vw, 4.2rem);
      max-width: 18ch;
      margin: 0.4rem 0 1rem;
    }

    .hero__eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.75rem;
      margin: 0;
    }

    .hero__lead {
      max-width: 60ch;
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .hero__cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }

    .button {
      padding: 0.75rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      border: 1px solid var(--ink);
    }

    .button.primary {
      background: var(--ink);
      color: #fff;
    }

    .button.ghost {
      background: transparent;
    }

    .hero__grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  </style>
</Base>
