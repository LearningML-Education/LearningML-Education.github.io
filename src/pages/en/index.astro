---
import Base from '../../layouts/Base.astro';
---
<Base
  title="LearningML"
  description="Learn AI by building real projects"
  lang="en"
  alternateUrl="/"
>
  <main class="hero">
    <header class="hero__header">
      <div class="hero__mark">LearningML</div>
      <nav class="hero__nav">
        <a href="/en/blog/">Blog</a>
        <a href="/en/studies-about-learningml/">Studies</a>
        <a href="https://learningml.org/manual/">Manual</a>
        <details class="hero__dropdown">
          <summary>
            About
            <span class="hero__caret" aria-hidden="true">▾</span>
          </summary>
          <div class="hero__submenu">
            <a href="/en/about-learningml-and-its-author/">About</a>
            <a href="/en/acknowledgment/">Acknowledgments</a>
          </div>
        </details>
      </nav>
    </header>

    <section class="hero__content">
      <p class="hero__eyebrow">Creative Artificial Intelligence</p>
      <h1>Learn Machine Learning by building projects with your data.</h1>
      <p class="hero__lead">
        LearningML combines a visual editor with Scratch so anyone can train models
        and create interactive experiences.
      </p>
      <div class="hero__cta">
        <a class="button primary" href="/lml-editor/">Open editor</a>
        <a class="button ghost" href="/scratch/">Go to Scratch</a>
      </div>
    </section>

    <section class="hero__grid">
      <article>
        <h3>Visual</h3>
        <p>Step-by-step guided models, no coding required.</p>
      </article>
      <article>
        <h3>Real projects</h3>
        <p>Bring your models into games, music, and art with Scratch.</p>
      </article>
      <article>
        <h3>Community</h3>
        <p>Resources and activities designed for the classroom.</p>
      </article>
    </section>
  </main>

  <style>
    .hero {
      min-height: 100vh;
      padding: 3rem clamp(1.5rem, 4vw, 5rem);
      display: grid;
      gap: 3rem;
    }

    .hero__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }

    .hero__mark {
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .hero__nav {
      display: flex;
      gap: 1.5rem;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      align-items: center;
    }
    .hero__dropdown {
      position: relative;
    }
    .hero__dropdown summary {
      list-style: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .hero__dropdown summary::-webkit-details-marker {
      display: none;
    }
    .hero__caret {
      font-size: 0.85rem;
      opacity: 0.7;
      transition: transform 0.2s ease;
    }
    .hero__dropdown[open] .hero__caret {
      transform: rotate(180deg);
    }
    .hero__submenu {
      position: absolute;
      top: 100%;
      right: 0;
      margin-top: 0.5rem;
      background: #fff;
      border-radius: 0.75rem;
      padding: 0.5rem 0.75rem;
      display: grid;
      gap: 0.4rem;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
      min-width: 180px;
      z-index: 5;
    }
    .hero__dropdown:not([open]) .hero__submenu {
      display: none;
    }
    .hero__submenu a {
      text-transform: none;
      letter-spacing: 0.02em;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .hero__content h1 {
      font-size: clamp(2.4rem, 4vw, 4.2rem);
      max-width: 18ch;
      margin: 0.4rem 0 1rem;
    }

    .hero__eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.75rem;
      margin: 0;
    }

    .hero__lead {
      max-width: 60ch;
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .hero__cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }

    .button {
      padding: 0.75rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      border: 1px solid var(--ink);
    }

    .button.primary {
      background: var(--ink);
      color: #fff;
    }

    .button.ghost {
      background: transparent;
    }

    .hero__grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  </style>
</Base>
